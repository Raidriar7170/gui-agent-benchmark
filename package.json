{
  "name": "gui-agent-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zero-dependency GUI agent benchmark workspace.",
  "scripts": {
    "start": "node server.mjs",
    "validate": "npm run validate:tasks && npm run validate:runs && npm run validate:uitars-preflight && npm run validate:uitars-live-target-guard && npm run validate:uitars-renderer-state-inspect && npm run validate:harness && npm run validate:capture && npm run validate:tunnel && npm run validate:oracle-baseline && npm run validate:real-round && npm run validate:step-traces && npm run validate:raw-uitars-trace && npm run validate:uitars-native-transcript-export && npm run validate:native-action-evidence-pack && npm run validate:native-action-evidence-gate && npm run validate:repeated-baseline && npm run validate:native-task-action-transcript && npm run validate:finish",
    "validate:tasks": "node scripts/validate-tasks.mjs",
    "validate:runs": "node scripts/validate-runs.mjs",
    "validate:uitars-preflight": "node scripts/validate-uitars-preflight.mjs",
    "validate:uitars-live-target-guard": "node scripts/validate-uitars-live-target-guard.mjs",
    "validate:uitars-renderer-state-inspect": "node scripts/validate-uitars-renderer-state-inspect.mjs",
    "validate:harness": "node scripts/validate-benchmark-harness.mjs",
    "validate:capture": "node scripts/validate-uitars-capture.mjs",
    "validate:tunnel": "node scripts/validate-tunnel-health.mjs",
    "validate:oracle-baseline": "node scripts/validate-oracle-baseline.mjs",
    "validate:real-round": "node scripts/validate-real-round.mjs",
    "validate:step-traces": "node scripts/validate-step-traces.mjs",
    "validate:raw-uitars-trace": "node scripts/validate-raw-uitars-trace.mjs",
    "validate:uitars-native-transcript-export": "node scripts/validate-uitars-native-transcript-export.mjs",
    "validate:native-action-evidence-pack": "node scripts/validate-native-action-evidence-pack.mjs",
    "validate:native-action-evidence-gate": "node scripts/validate-native-action-evidence-gate.mjs --allow-missing",
    "validate:p2-native-action-evidence": "node scripts/validate-native-action-evidence-gate.mjs --require-sample --expected-task-ids settings-toggle,onboarding-form,ticket-review --min-native-task-actions-per-task 1",
    "validate:repeated-baseline": "node scripts/validate-repeated-baseline.mjs",
    "validate:native-task-action-transcript": "node scripts/validate-native-task-action-transcript-smoke.mjs",
    "validate:finish": "node scripts/validate-finish-gate.mjs",
    "uitars:preflight": "node scripts/uitars-preflight-runner.mjs",
    "uitars:live-guard": "node scripts/uitars-live-target-guard.mjs",
    "uitars:renderer-state-inspect": "node scripts/uitars-renderer-state-inspect.mjs",
    "uitars:capture": "node scripts/uitars-capture-run.mjs",
    "uitars:harness": "node scripts/uitars-benchmark-harness.mjs",
    "uitars:real-round": "node scripts/uitars-real-round.mjs",
    "uitars:ingest-raw-trace": "node scripts/ingest-uitars-raw-trace.mjs",
    "uitars:export-native-transcript": "node scripts/export-uitars-native-transcript.mjs",
    "uitars:repeated-baseline": "node scripts/uitars-repeated-baseline.mjs",
    "analyze:p2-native-action-evidence": "node scripts/analyze-native-action-evidence-pack.mjs",
    "check:local": "node scripts/check-local.mjs",
    "check:tunnel": "node scripts/check-tunnel.mjs",
    "check:remote": "node scripts/check-remote.mjs",
    "check:finish": "node scripts/check-finish.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
