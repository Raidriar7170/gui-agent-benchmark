{
  "name": "gui-agent-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zero-dependency GUI agent benchmark workspace.",
  "scripts": {
    "start": "node server.mjs",
    "validate": "npm run validate:tasks && npm run validate:runs && npm run validate:uitars-preflight && npm run validate:harness",
    "validate:tasks": "node scripts/validate-tasks.mjs",
    "validate:runs": "node scripts/validate-runs.mjs",
    "validate:uitars-preflight": "node scripts/validate-uitars-preflight.mjs",
    "validate:harness": "node scripts/validate-benchmark-harness.mjs",
    "uitars:preflight": "node scripts/uitars-preflight-runner.mjs",
    "uitars:harness": "node scripts/uitars-benchmark-harness.mjs",
    "check:local": "node scripts/check-local.mjs",
    "check:tunnel": "node scripts/check-tunnel.mjs",
    "check:remote": "node scripts/check-remote.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
